# OpenMU-Origins Game Server / AdminPanel API
OPENMU_API_URL=http://127.0.0.1:8085
OPENMU_API_KEY=replace-with-adminpanel-api-key-at-least-32-chars

# Website BFF PostgreSQL Database (isolated `web` schema)
DATABASE_URL=postgres://openmu:openmu_password@127.0.0.1:5432/openmu
POSTGRES_DB=openmu
POSTGRES_USER=openmu
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Security & Sessions (SESSION_SECRET must be >= 32 chars in production)
NODE_ENV=development
PORT=8080
TRUST_PROXY=false
UPSTREAM_TIMEOUT_MS=8000
SESSION_SECRET=replace-with-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_WEB_URL=http://localhost:5173

# Payment Providers (Top-Up)
PAYMENT_WEBHOOK_SECRET=replace-with-hmac-webhook-secret
PROMPTPAY_ID=
PROMPTPAY_NAME=OpenMU-Origins
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Explicit dev/test sandbox toggle (automatically ignored in NODE_ENV=production)
ENABLE_DEV_TOPUP_SANDBOX=false
ALLOW_INMEMORY_WEB_STORE=false

# Frontend Vite Settings
VITE_CLIENT_DOWNLOAD_URL=https://github.com/project-bells/OpenMU-Origins/releases
VITE_CLIENT_SIZE=1.8 GB
VITE_DEV_API_TARGET=http://127.0.0.1:8080
