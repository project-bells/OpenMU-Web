# Build-time public settings (never put secrets in VITE_* variables)
VITE_CLIENT_DOWNLOAD_URL=https://downloads.example.com/OpenMU-Client.zip
VITE_CLIENT_SIZE=2.1 GB

# Local Vite development proxy. Run the production gateway separately on this URL.
DEV_API_TARGET=http://localhost:8080

# Production gateway settings
OPENMU_API_URL=https://admin.openmu.example.com
OPENMU_API_KEY=replace-with-an-operator-api-key-of-at-least-32-characters
PORT=8080
TRUST_PROXY=true
UPSTREAM_TIMEOUT_MS=8000
